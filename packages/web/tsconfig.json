{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "types": ["vite/client"],
    // `composite` is what makes this package referenceable from the root solution, so `pnpm test`
    // (`tsc -b && vitest run`) typechecks it (05-AUDIT-2.md structural cause 2). TypeScript 5.9
    // permits composite together with `noEmit` and `allowImportingTsExtensions`, so nothing is
    // emitted except the tsbuildinfo the root `clean` script already removes.
    "composite": true
  },
  // `tests` is included deliberately: with `include: ["src"]` the fourteen spec files under
  // `packages/web/tests` were typechecked by NOTHING in the repo, not even the package build.
  "include": ["src", "tests"]
}
